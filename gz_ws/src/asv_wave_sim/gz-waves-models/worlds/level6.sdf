<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="level6">
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
      <background_color>0.8 0.8 0.8</background_color>
    </plugin>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
    </plugin>

    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat">
    </plugin>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>40.595009</latitude_deg>
      <longitude_deg>-79.99974</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.6 0.6 0.6 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://no_waves</uri>
    </include>
    <include>
      <name>cmra_terrain</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://cmra_models/terrain</uri>
    </include>

    <include>
      <name>cmra_lakefloor</name>
      <pose>0 0 -7.75 0 0 0</pose>
      <uri>model://cmra_models/lakefloor</uri>
    </include>
    <!-- <include>
      <uri>model://ocean_floor</uri>
      <pose>0 -45 -10 0 0 0</pose>
    </include>

    <include>
      <uri>model://world_mass</uri>
      <pose>0 0 -6 0 0 0</pose>
    </include> -->

    <!--
      Boat 1 uses the existing SITL_Models/Gazebo/models/blueboat model.
      That model's ArduPilotPlugin listens on FDM port 9002, which matches
      sim_vehicle.py instance -I0.
    -->
    <include>
      <name>blueboat</name>
      <pose>0 -0.75 0 0 0 -1.5708</pose>
      <uri>model://blueboat</uri>
    </include>

    <!--
      Boat 2 uses the added SITL_Models/Gazebo/models/blueboat2 model.
      Its ArduPilotPlugin listens on FDM port 9012, which matches
      sim_vehicle.py instance -I1. The two boats start side-by-side with
      enough spacing to avoid initial collision while still appearing next
      to each other.
    -->
    <include>
      <name>blueboat2</name>
      <pose>0 0.75 0 0 0 -1.5708</pose>
      <uri>model://blueboat2</uri>
    </include>
    <include>
      <name>blueboat3</name>
      <pose>0 -2 0 0 0 -1.5708</pose>
      <uri>model://blueboat3</uri>
    </include>
     <include>
      <name>blueboat4</name>
      <pose>0 -4 0 0 0 -1.5708</pose>
      <uri>model://blueboat4</uri>
    </include>

    
    <!-- POSITIVE HAZZARDS -->
    <include>
      <name>cmra_airplane</name>
      <pose>-20 -15 -10 0 0 0</pose>
      <uri>model://cmra_models/airplane</uri>
    </include>
    <include>
      <name>cmra_boat</name>
      <pose>-5 -15 -10 0 0 0</pose>
      <uri>model://cmra_models/boat</uri>
    </include>
    <include>
      <name>cmra_bus</name>
      <pose>5 -15 -10 0 0 0</pose>
      <uri>model://cmra_models/bus</uri>
    </include>
    <include>
      <name>cmra_car_wrecked</name>
      <pose>10 -30 -10 0 0 0</pose>
      <uri>model://cmra_models/car_wrecked</uri>
    </include>
    <include>
      <name>cmra_drone</name>
      <pose>-8 -30 -10 0 0 0</pose>
      <uri>model://cmra_models/drone</uri>
    </include>
    <include>
      <name>cmra_drum</name>
      <pose>-10 -30 -10 0 0 0</pose>
      <uri>model://cmra_models/drum</uri>
    </include>
    <include>
      <name>cmra_truck</name>
      <pose>5 -45 -10 0 0 0</pose>
      <uri>model://cmra_models/truck</uri>
    </include>

    <!-- NEGATIVE HAZZARDS -->
    <include>
      <name>cmra_canoe</name>
      <pose>20 -15 -10 0 0 0</pose>
      <uri>model://cmra_models/canoe</uri>
    </include>
    <include>
      <name>cmra_couch</name>
      <pose>-5 -30 -10 0 0 0</pose>
      <uri>model://cmra_models/couch</uri>
    </include>
    <include>
      <name>cmra_picnic_table</name>
      <pose>-5 -45 -10 0 0 0</pose>
      <uri>model://cmra_models/picnic_table</uri>
    </include>
    <include>
      <name>cmra_seaweed</name>
      <pose>0 -45 -10 0 0 0</pose>
      <uri>model://cmra_models/seaweed</uri>
    </include>

    <include>
      <uri>model://dock</uri>
      <name>dock_1</name>
      <pose>1.8 1.2 -.1 0 0 -1.5708</pose>
    </include> 

    <!-- ZONE 1 -->
    <include>
      <uri>model://buoy_marker</uri>
      <name>B1</name>
      <pose>-40 -80 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B2</name>
      <pose>-40 -40 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B3</name>
      <pose>40 -80 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B4</name>
      <pose>40 -40 0 0 0 0</pose>
    </include>

    <!-- ZONE 2 -->
    <include>
      <uri>model://buoy_marker</uri>
      <name>B5</name>
      <pose>100 -40 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B6</name>
      <pose>100 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B7</name>
      <pose>180 -40 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B8</name>
      <pose>180 0 0 0 0 0</pose>
    </include>

    <!-- ZONE 3 -->
    <include>
      <uri>model://buoy_marker</uri>
      <name>B9</name>
      <pose>150 120 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B10</name>
      <pose>150 40 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B11</name>
      <pose>190 120 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B12</name>
      <pose>190 40 0 0 0 0</pose>
    </include>

    <!-- ZONE 4 -->
    <include>
      <uri>model://buoy_marker</uri>
      <name>B13</name>
      <pose>90 145 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B14</name>
      <pose>90 185 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B15</name>
      <pose>170 145 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B16</name>
      <pose>170 185 0 0 0 0</pose>
    </include>

    <!-- Underwater test objects retained for level-style mission content. -->
   
  </world>
</sdf>
