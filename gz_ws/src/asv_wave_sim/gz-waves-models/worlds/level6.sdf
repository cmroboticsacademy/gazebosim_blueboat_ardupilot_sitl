<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="level6">
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
      <background_color>0.8 0.8 0.8</background_color>
    </plugin>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
    </plugin>

    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat">
    </plugin>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>40.595009</latitude_deg>
      <longitude_deg>-79.99974</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.6 0.6 0.6 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://no_waves</uri>
    </include>
    <include>
      <name>cmra_terrain</name>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://cmra_models/terrain</uri>
    </include>

    <include>
      <name>cmra_lakefloor</name>
      <pose>0 0 -7.75 0 0 0</pose>
      <uri>model://cmra_models/lakefloor</uri>
    </include>
    <!-- <include>
      <uri>model://ocean_floor</uri>
      <pose>0 -45 -10 0 0 0</pose>
    </include>

    <include>
      <uri>model://world_mass</uri>
      <pose>0 0 -6 0 0 0</pose>
    </include> -->

    <!--
      Boat 1 uses the existing SITL_Models/Gazebo/models/blueboat model.
      That model's ArduPilotPlugin listens on FDM port 9002, which matches
      sim_vehicle.py instance -I0.
    -->
    <include>
      <name>blueboat</name>
      <pose>0 1 0 0 0 -1.5708</pose>
      <uri>model://blueboat</uri>
    </include>
    <include>
      <name>blueboat2</name>
      <pose>0 -1 0 0 0 -1.5708</pose>
      <uri>model://blueboat2</uri>
    </include>
    <include>
      <name>blueboat3</name>
      <pose>0 -3 0 0 0 -1.5708</pose>
      <uri>model://blueboat3</uri>
    </include>
     <include>
      <name>blueboat4</name>
      <pose>0 -5 0 0 0 -1.5708</pose>
      <uri>model://blueboat4</uri>
    </include>

    <!--
      mission4_sim.launch.py replaces the contents between these markers in a
      temporary copy of this world. Keep both marker comments in this file.
    -->
    <!-- MISSION4_HAZARDS_START -->
    <!-- Seeded hazard includes are inserted here at launch time. -->
    <!-- MISSION4_HAZARDS_END -->

    <include>
      <uri>model://dock</uri>
      <name>dock_1</name>
      <pose>1.8 0 -.1 0 0 -1.5708</pose>
    </include> 

    <!-- ZONE 1 -->
    <include>
      <uri>model://buoy_marker</uri>
      <name>B1</name>
      <pose>-40 -80 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B2</name>
      <pose>-40 -40 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B3</name>
      <pose>40 -80 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B4</name>
      <pose>40 -40 0 0 0 0</pose>
    </include>

    <!-- ZONE 2 -->
    <include>
      <uri>model://buoy_marker</uri>
      <name>B5</name>
      <pose>100 -40 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B6</name>
      <pose>100 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B7</name>
      <pose>180 -40 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B8</name>
      <pose>180 0 0 0 0 0</pose>
    </include>

    <!-- ZONE 3 -->
    <include>
      <uri>model://buoy_marker</uri>
      <name>B9</name>
      <pose>150 120 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B10</name>
      <pose>150 40 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B11</name>
      <pose>190 120 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B12</name>
      <pose>190 40 0 0 0 0</pose>
    </include>

    <!-- ZONE 4 -->
    <include>
      <uri>model://buoy_marker</uri>
      <name>B13</name>
      <pose>90 145 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B14</name>
      <pose>90 185 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B15</name>
      <pose>170 145 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://buoy_marker</uri>
      <name>B16</name>
      <pose>170 185 0 0 0 0</pose>
    </include>

    <!-- Underwater test objects retained for level-style mission content. -->
   
  </world>
</sdf>
