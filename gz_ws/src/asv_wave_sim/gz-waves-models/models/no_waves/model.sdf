<?xml version='1.0' ?>
<sdf version="1.6">
  <model name="waves">
    <static>true</static>

    <!--
      Keep a flat wavefield for the hydrodynamics plugin so the boats remain
      buoyant, but do not spend runtime updating waves that are intentionally
      disabled in the no_waves missions.
    -->
    <plugin
        filename="gz-waves1-waves-model-system"
        name="gz::sim::systems::WavesModel">
      <static>1</static>
      <wave>
        <algorithm>sinusoid</algorithm>
        <tile_size>400</tile_size>
        <cell_count>8</cell_count>
        <amplitude>0</amplitude>
        <period>1</period>
      </wave>
    </plugin>

    <link name="base_link">
      <!--
        Static visual water replaces the dynamic WavesVisual deformation
        pipeline. It preserves the visible water surface without per-frame
        mesh updates.
      -->
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>800 800</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.12 0.08 0.02 0.92</ambient>
          <diffuse>0.25 0.18 0.06 0.92</diffuse>
          <specular>0.15 0.12 0.08 0.92</specular>
          <pbr>
            <metal>
              <albedo_map>materials/water.jpg</albedo_map>
              <normal_map>materials/wave_normals.dds</normal_map>
              <environment_map>materials/skybox_lowres.dds</environment_map>
              <roughness>0.3</roughness>
              <metalness>0.1</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
