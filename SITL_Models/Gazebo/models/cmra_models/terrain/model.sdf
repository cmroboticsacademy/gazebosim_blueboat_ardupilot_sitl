<?xml version="1.0"?>
<sdf version="1.6">
  <model name="cmra_terrain">
    <static>true</static>

    <link name="terrain_link">
      <collision name="terrain_collision">
        <geometry>
          <mesh>
            <uri>model://cmra_models/terrain/terrain.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>

      <visual name="terrain_visual">
        <geometry>
          <mesh>
            <uri>model://cmra_models/terrain/terrain.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
