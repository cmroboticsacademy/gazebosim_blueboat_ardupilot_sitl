<?xml version="1.0"?>
<sdf version="1.9">
  <model name="blueboat_camera_pod">
    <static>true</static>
    <link name="camera_link">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="fpv_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/camera_pod/camera/image</topic>
        <camera>
          <triggered>true</triggered>
          <trigger_topic>/camera_pod/camera/trigger</trigger_topic>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>RGB_INT8</format>
            <anti_aliasing>1</anti_aliasing>
          </image>
          <clip>
            <near>0.05</near>
            <far>250</far>
          </clip>
        </camera>
        <plugin name="BlueBoatGstCameraPlugin"
                filename="libBlueBoatGstCameraPlugin.so">
          <image_topic>/camera_pod/camera/image</image_topic>
          <enable_topic>/camera_pod/camera/enable_streaming</enable_topic>
          <config_topic>/camera_pod/camera/stream_config</config_topic>
          <trigger_topic>/camera_pod/camera/trigger</trigger_topic>
          <udp_host>127.0.0.1</udp_host>
          <udp_port>5600</udp_port>
          <output_width>256</output_width>
          <output_height>256</output_height>
          <output_fps>16</output_fps>
          <bitrate_kbps>800</bitrate_kbps>
          <preserve_aspect>false</preserve_aspect>
        </plugin>
      </sensor>
    </link>
    <plugin name="BlueBoatCameraFollowerPlugin"
            filename="libBlueBoatCameraFollowerPlugin.so">
      <target_topic>/camera_pod/target</target_topic>
      <default_target>blueboat</default_target>
      <offset>0.55 0 0.28 0 0 0</offset>
    </plugin>
  </model>
</sdf>
